# Server-side Directus connection. Never expose the token with NEXT_PUBLIC_*.
DIRECTUS_URL=http://127.0.0.1:18056
DIRECTUS_TOKEN=

# true = always use synthetic storefront data.
# false = prefer Directus and fall back to mock data when the CMS is unavailable.
STOREFRONT_MOCK_MODE=true

NEXT_PUBLIC_SITE_URL=http://localhost:3000
