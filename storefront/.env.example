# Server-side Directus connection. Never expose the token with NEXT_PUBLIC_*.
DIRECTUS_URL=http://127.0.0.1:18056
DIRECTUS_TOKEN=

# true = always use synthetic storefront data and do not require Directus.
STOREFRONT_MOCK_MODE=true

# Optional development-only escape hatch.
# Keep false in production: a failing live CMS must not silently show fictional catalog data.
STOREFRONT_ALLOW_MOCK_FALLBACK=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000
